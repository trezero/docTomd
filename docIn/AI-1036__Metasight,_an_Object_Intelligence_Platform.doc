</tr>
<tr>
<td class=3D"confluenceTd">
<p><strong>video_id</strong></p></td>
<td class=3D"confluenceTd">
<p><code>VarChar</code></p></td>
<td class=3D"confluenceTd">
<p>N/A</p></td>
<td class=3D"confluenceTd">
<p>Primary Key</p></td>
<td class=3D"confluenceTd">
<p>A unique identifier for the video file, serving as the primary key.</p>
<p></p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p><strong>global_video_embedding</strong></p></td>
<td class=3D"confluenceTd">
<p><code>Vector</code></p></td>
<td class=3D"confluenceTd">
<p>1024</p></td>
<td class=3D"confluenceTd">
<p>Vector (HNSW)</p></td>
<td class=3D"confluenceTd">
<p>A single embedding representing the thematic content of the entire video=
.</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p><strong>duration_seconds</strong></p></td>
<td class=3D"confluenceTd">
<p><code>Int64</code></p></td>
<td class=3D"confluenceTd">
