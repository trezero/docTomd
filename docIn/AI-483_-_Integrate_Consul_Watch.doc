<h3 id=3D"AI-483-IntegrateConsulWatch-DockerComposeConfiguration">Docker Co=
mpose Configuration</h3>
<p>Here's a sample Docker Compose configuration that includes the sidecar:y=
aml</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: bash; gutter: false; theme: Confluence" data-theme=3D"Confluence">version=
: '3.8'

services:
  app:
    image: aiplus/myservice:latest
    environment:
      - CONSUL_HOST=3Dconsul
      - CONSUL_PORT=3D8500
      - USE_CONSUL_WATCH=3Dtrue
      - CONSUL_WATCH_SIDECAR_HOST=3Dconsul-watch-sidecar
      - CONSUL_WATCH_SIDECAR_PORT=3D8501
    depends_on:
      consul-watch-sidecar:
        condition: service_healthy
    networks:
      - aiplus-network

  consul-watch-sidecar:
    image: aiplus/consul-watch-sidecar:latest
    environment:
      - CONSUL_HOST=3Dconsul
      - CONSUL_PORT=3D8500
      - CONSUL_TOKEN=3D${CONSUL_TOKEN}
    depends_on:
      consul:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8501/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    networks:
      - aiplus-network

  consul:
    image: consul:latest
    ports:
      - "8500:8500"
    volumes:
      - consul-data:/consul/data
    networks:
      - aiplus-network
    healthcheck:
      test: ["CMD", "consul", "members"]
      interval: 10s
      timeout: 5s
      retries: 3

networks:
  aiplus-network:

volumes:
  consul-data:</pre>
</div>
</div>
<h3 id=3D"AI-483-IntegrateConsulWatch-KubernetesImplementation(Future)">Kub=
ernetes Implementation (Future)</h3>
<p>For Kubernetes, we'll use a sidecar container pattern:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: bash; gutter: false; theme: Confluence" data-theme=3D"Confluence">apiVers=
ion: apps/v1
kind: Deployment
metadata:
  name: aiplus-service
spec:
  replicas: 3
  selector:
    matchLabels:
      app: aiplus-service
  template:
    metadata:
      labels:
        app: aiplus-service
    spec:
      containers:
      - name: aiplus-service
        image: aiplus/myservice:latest
        env:
        - name: CONSUL_HOST
          value: "consul.service.consul"
        - name: CONSUL_PORT
          value: "8500"
        - name: USE_CONSUL_WATCH
          value: "true"
        - name: CONSUL_WATCH_SIDECAR_HOST
          value: "localhost"
        - name: CONSUL_WATCH_SIDECAR_PORT
          value: "8501"
        ports:
        - containerPort: 8000
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 5
          periodSeconds: 10
         =20
      - name: consul-watch-sidecar
        image: aiplus/consul-watch-sidecar:latest
        env:
        - name: CONSUL_HOST
          value: "consul.service.consul"
        - name: CONSUL_PORT
          value: "8500"
        - name: CONSUL_TOKEN
          valueFrom:
            secretKeyRef:
              name: consul-secrets
              key: token
        ports:
        - containerPort: 8501
        livenessProbe:
          httpGet:
            path: /health
            port: 8501
          initialDelaySeconds: 5
          periodSeconds: 10</pre>
</div>
</div>
<h3 id=3D"AI-483-IntegrateConsulWatch-TestingImplementation">Testing Implem=
entation</h3>
<p>Here's a sample test script to verify the integration:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: bash; gutter: false; theme: Confluence" data-theme=3D"Confluence">import =
unittest
import os
import time
from unittest.mock import patch, MagicMock

from aiplus.core.config.baseConfig import BaseConfig
from aiplus.core.env import is_consul_watch_sidecar_available

class TestConsulWatchIntegration(unittest.TestCase):
   =20
    def setUp(self):
        # Set up environment for tests
        os.environ["CONSUL_HOST"] =3D "localhost"
        os.environ["CONSUL_PORT"] =3D "8500"
       =20
        # Clear any previous settings
        if "USE_CONSUL_WATCH" in os.environ:
            del os.environ["USE_CONSUL_WATCH"]
        if "USE_CONSUL_WATCH_SIDECAR" in os.environ:
            del os.environ["USE_CONSUL_WATCH_SIDECAR"]
           =20
    def test_environment_detection(self):
        # Test Docker environment detection
        with patch('os.path.exists', return_value=3DTrue):
            self.assertTrue(is_docker())
           =20
        # Test sidecar availability detection
        with patch('socket.socket') as mock_socket:
            mock_socket.return_value.connect.return_value =3D None
            self.assertTrue(is_consul_watch_sidecar_available())
           =20
        with patch('socket.socket') as mock_socket:
            mock_socket.return_value.connect.side_effect =3D ConnectionRefu=
