<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: py; gutter: false; theme: Confluence" data-theme=3D"Confluence"># Collect=
ion creation with HNSW
configuration =3D {
    "hnsw": {
        "space": "cosine",
        "ef_construction": hnsw_params.get("ef_construction"),
        "max_neighbors": hnsw_params.get("max_neighbors"),
        "ef_search": hnsw_params.get("ef_search")
    }
}

collection =3D client.create_collection(
    name=3Dcollection_name,
    configuration=3Dconfiguration
)</pre>
