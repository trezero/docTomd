&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"time_end_milliseconds":&nbsp;12000,
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"object_class":&nbsp;"vehicle",
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"object_detail":&nbsp;"car",
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"total_duration":&nbsp;"5000ms"
&nbsp;&nbsp;&nbsp;&nbsp;}
&nbsp;&nbsp;],
&nbsp;&nbsp;"object-detected-1":&nbsp;"person",
&nbsp;&nbsp;"object-detected-2":&nbsp;"vehicle"
}</pre>
</div>
</div>
<p></p>
<h2 id=3D"AIP-72:MetadataIntegrationintoVision-FacialRecognition">Facial Re=
cognition</h2>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: bash; gutter: false; theme: Confluence" data-theme=3D"Confluence">{
